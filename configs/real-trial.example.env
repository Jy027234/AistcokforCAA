# 复制为仓库根目录 real-trial.env 后填写。real-trial.env 已被 *.env 忽略，
# 不会进入 Git；不要在本模板中写真实账户信息或密钥。

# Windows 路径在 Compose env 文件中使用正斜杠。
AQUANT_HOST_DATA_DIR=E:/IT/A股量化交易/deploy/universe-snapshot
AQUANT_HOST_PIPELINE_DIR=E:/IT/A股量化交易/deploy/agentctl-q0

# 本机单用户试运行边界，不是公网生产认证。
AQUANT_IDENTITY_MODE=LOCAL_LOOPBACK_DEMO
AQUANT_TRIAL_SUBJECT=user:demo

# 优先按自己的券商合同填写。示例：万 2.5 = 0.00025；最低 5 元 = 500 分。
# 若只能先用经使用者明确批准的试运行假设，再把 SOURCE 设为
# USER_APPROVED_ASSUMPTION；它不会被界面误称为实际合同费率。
# 留空时真实研究仍可读，但预览、冻结、执行和估值会被拒绝。
AQUANT_COMMISSION_RATE=
AQUANT_COMMISSION_MIN_CENTS=
AQUANT_COMMISSION_SOURCE=

# 仅当本机透明代理使用 fake-IP 网段时，在本机 env 中显式填写；见 ADR-002。
AQUANT_TRUSTED_PROXY_NETWORKS=
